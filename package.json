{
  "name": "marketchain-contract",
  "version": "1.0.0",
  "description": "MarketChain Anchor Registry - Smart Contract V1 on Polygon",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:integration": "hardhat test test/integration.test.ts --network localhost",
    "test:testnet": "hardhat test test/testnet.test.ts --network polygonAmoy",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:hardhat": "hardhat run scripts/deploy.ts --network hardhat",
    "deploy:amoy": "hardhat run scripts/deploy.ts --network polygonAmoy",
    "deploy:polygon": "hardhat run scripts/deploy.ts --network polygon",
    "verify:amoy": "hardhat verify --network polygonAmoy",
    "verify:polygon": "hardhat verify --network polygon"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.15",
    "typescript": "~5.7.0"
  }
}
