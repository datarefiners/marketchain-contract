# Fichier d'exemple. Copier vers .env et renseigner les vraies valeurs.
# Ne jamais commiter le fichier .env (il est dans .gitignore).

# Clé privée du wallet admin (sans 0x)
# Pour le testnet, utiliser un wallet dédié, jamais un wallet de production.
PRIVATE_KEY=

# RPC URLs
# Polygon Amoy testnet (https://polygon.technology/amoy)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Polygon Mainnet
POLYGON_RPC_URL=https://polygon-rpc.com

# Polygonscan API key pour la vérification du contrat (https://polygonscan.com/myapikey)
POLYGONSCAN_API_KEY=
